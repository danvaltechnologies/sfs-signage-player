# ---- Core ----
NODE_ENV=development
PORT=3000
# Comma-separated list of origins allowed to call the API (the console frontend)
CORS_ORIGINS=http://localhost:8080,https://console.sundryfoods.com

# ---- Database (PostgreSQL) ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sundry_signage?schema=public"

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-too-and-keep-it-different
JWT_REFRESH_EXPIRES_IN=30d

# ---- POS webhook ----
# Shared secret used to sign POS webhook payloads (HMAC-SHA256, hex)
POS_WEBHOOK_SECRET=change-me

# ---- SMTP email alerts ----
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=alerts@sundryfoods.com
SMTP_PASSWORD=
MAIL_FROM="Sundry Signage <alerts@sundryfoods.com>"
# Where deep links in emails point
APP_BASE_URL=https://console.sundryfoods.com

# ---- Web push (run `npm run keys:vapid` to generate) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@sundryfoods.com

# ---- Monitoring thresholds ----
# Minutes without a heartbeat before a screen is treated as offline
SCREEN_OFFLINE_AFTER_MINUTES=15
# Minutes a queue ticket may run past its ready time before an alert fires
QUEUE_OVERDUE_ALERT_MINUTES=5
